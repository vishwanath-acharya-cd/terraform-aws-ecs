[
  {
    "name": "apache",
    "image": "httpd:latest",
    "essential": true,
    "cpu": 256,
    "memory": 512,
    "portMappings": [
      {
        "containerPort": 80,
        "hostPort": 80
      }
    ],
    "environment": [
      { "name": "APP_ENV",  "value": "production" },
      { "name": "APP_NAME", "value": "apache-fargate-service" }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group":         "apache-fargate-container-logs",
        "awslogs-region":        "eu-west-1",
        "awslogs-stream-prefix": "apache"
      }
    }
  }
]
