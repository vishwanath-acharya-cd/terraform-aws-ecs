[
  {
    "name": "nginx",
    "image": "nginx:latest",
    "essential": true,
    "cpu": 256,
    "memory": 512,
    "portMappings": [
      {
        "containerPort": 80,
        "hostPort": 0
      }
    ],
    "environment": [
      { "name": "APP_ENV",  "value": "production" },
      { "name": "APP_NAME", "value": "nginx-service" }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group":         "nginx-container-logs",
        "awslogs-region":        "eu-west-1",
        "awslogs-stream-prefix": "nginx"
      }
    }
  }
]
