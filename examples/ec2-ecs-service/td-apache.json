[
  {
    "name": "apache",
    "image": "httpd:latest",
    "essential": true,
    "cpu": 256,
    "memory": 512,
    "portMappings": [
      {
        "containerPort": 80,
        "hostPort": 0
      }
    ],
    "environment": [
      { "name": "APP_ENV",  "value": "production" },
      { "name": "APP_NAME", "value": "apache-service" }
    ],
    "secrets": [
      { "name": "DB_PASSWORD", "valueFrom": "ecs/apache/db-password:DB_PASSWORD::" },
      { "name": "API_KEY",     "valueFrom": "ecs/apache/api-key:API_KEY::" }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group":         "apache-container-logs",
        "awslogs-region":        "eu-west-1",
        "awslogs-stream-prefix": "apache"
      }
    }
  }
]
